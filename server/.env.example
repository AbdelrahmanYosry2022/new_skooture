# Database — MySQL / MariaDB
# Local:   mysql://USER:PASSWORD@localhost:3306/skooture
# cPanel:  mysql://USER:PASSWORD@localhost:3306/cpanel_dbname
# Neon/PlanetScale: replace with their connection string
DATABASE_URL="mysql://root:password@localhost:3306/skooture"

# JWT secret — change this to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# Admin seed credentials
ADMIN_EMAIL="admin@skooture.ai"
ADMIN_PASSWORD="changeme123"

# Server port
PORT=3001

# Environment
NODE_ENV="development"
